{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "AHP-ACP Gateway on Azure Container Apps",
    "description": "Deploy AHP-ACP Gateway with pre-installed OpenCode (free Zen models) to Azure Container Apps."
  },
  "parameters": {
    "appName": {
      "type": "string",
      "defaultValue": "[concat('ahp-gateway-', uniqueString(resourceGroup().id))]",
      "minLength": 2,
      "maxLength": 32,
      "metadata": {
        "description": "Name of the Azure Container App."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "authToken": {
      "type": "secureString",
      "minLength": 8,
      "metadata": {
        "description": "Bearer / query token required by AHP clients to connect to this public gateway."
      }
    },
    "containerImage": {
      "type": "string",
      "defaultValue": "ghcr.io/formulahendry/ahp-acp-gateway:latest",
      "metadata": {
        "description": "Container image to deploy."
      }
    },
    "enabledProviders": {
      "type": "string",
      "defaultValue": "opencode",
      "metadata": {
        "description": "Comma-separated list of ACP provider IDs to enable (default: opencode, or * for all)."
      }
    },
    "minReplicas": {
      "type": "int",
      "defaultValue": 0,
      "minValue": 0,
      "maxValue": 10,
      "metadata": {
        "description": "Minimum number of replicas (0 scales to zero when idle to save cost; 1 keeps the instance warm)."
      }
    },
    "maxReplicas": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "maxValue": 10,
      "metadata": {
        "description": "Maximum number of replicas (recommended 1 for stateful in-container SQLite)."
      }
    }
  },
  "variables": {
    "environmentName": "[concat(parameters('appName'), '-env')]"
  },
  "resources": [
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[variables('environmentName')]",
      "location": "[parameters('location')]",
      "properties": {
        "workloadProfiles": [
          {
            "name": "Consumption",
            "workloadProfileType": "Consumption"
          }
        ]
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]"
      ],
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "secrets": [
            {
              "name": "ahp-auth-token",
              "value": "[parameters('authToken')]"
            }
          ],
          "ingress": {
            "external": true,
            "targetPort": 8765,
            "transport": "auto",
            "allowInsecure": false
          }
        },
        "template": {
          "containers": [
            {
              "name": "ahp-acp-gateway",
              "image": "[parameters('containerImage')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "PORT",
                  "value": "8765"
                },
                {
                  "name": "AHP_HOST",
                  "value": "0.0.0.0"
                },
                {
                  "name": "AHP_PATH",
                  "value": "/ahp"
                },
                {
                  "name": "AHP_TLS_TERMINATED",
                  "value": "true"
                },
                {
                  "name": "AHP_ENABLED_PROVIDERS",
                  "value": "[parameters('enabledProviders')]"
                },
                {
                  "name": "AHP_AUTH_TOKEN",
                  "secretRef": "ahp-auth-token"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8765
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 30
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8765
                  },
                  "initialDelaySeconds": 3,
                  "periodSeconds": 10
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "fqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('appName'))).configuration.ingress.fqdn]"
    },
    "healthCheckUrl": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.App/containerApps', parameters('appName'))).configuration.ingress.fqdn, '/healthz')]"
    },
    "websocketUrl": {
      "type": "string",
      "value": "[concat('wss://', reference(resourceId('Microsoft.App/containerApps', parameters('appName'))).configuration.ingress.fqdn, '/ahp?token=<YOUR_AUTH_TOKEN>')]"
    },
    "vscodeRemoteAgentHostAddress": {
      "type": "string",
      "value": "[concat('wss://', reference(resourceId('Microsoft.App/containerApps', parameters('appName'))).configuration.ingress.fqdn, '/ahp?token=<YOUR_AUTH_TOKEN>')]"
    }
  }
}
